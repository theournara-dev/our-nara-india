// OUR:NARA — Prisma schema
// PostgreSQL · Prisma 7 (`prisma-client` TS generator)
//
// Money is stored as integer minor units (paise for INR) to avoid floating
// point errors. Every money field carries a `currency` so the store can add
// multi-currency pricing later without a migration of intent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth)
// ---------------------------------------------------------------------------
// The User model is the Better Auth user. Passwords are stored in the Account
// model (providerId = "credential"), not on the user. `role` is one of
// normal | manager | admin; `permissions` holds per-user permission overrides
// merged on top of the role defaults (see src/lib/permissions.ts).

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  username        String?   @unique // member ID (lowercase a-z0-9, 4-16)
  displayUsername String?   @map("display_username")
  role            String    @default("normal")
  banned          Boolean?  @default(false)
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires")

  // Custom signup fields
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  country       String?
  addressLine1  String? @map("address_line1")
  addressLine2  String? @map("address_line2")
  city          String?
  state         String?
  postal        String?
  telephoneCode String? @map("telephone_code")
  telephone     String?
  mobileCode    String? @map("mobile_code")
  mobile        String?
  permissions   Json? // per-user permission overrides, e.g. { product: ["create"] }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  wishlist          WishlistItem[]
  recentViews       RecentView[]
  mileage           MileageLedger[]
  couponRedemptions CouponRedemption[]
  sessions          Session[]
  accounts          Account[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Address {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  label     String
  recipient String
  line1     String
  line2     String?
  city      String
  state     String?
  postal    String
  country   String  @default("IN")
  phone     String?
  isDefault Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?  @map("logo_url")
  coverUrl    String?  @map("cover_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  // Feature rollout: enable Buy Now for every product of this brand.
  buyNowEnabled Boolean @default(false) @map("buy_now_enabled")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  brandId        String   @map("brand_id")
  categoryId     String   @map("category_id")
  name           String
  summary        String?
  shortTags      String[] @map("short_tags")
  description    String?
  priceCents     Int      @map("price_cents")
  // International-store price in INR paise (our-nara.co.kr), charged on the
  // global store only. Nullable until admins set it; the global store then
  // falls back to the local price (see src/lib/money.ts priceForVersion).
  globalPriceCents Int?   @map("global_price_cents")
  compareAtCents Int?     @map("compare_at_cents")
  globalCompareAtCents Int? @map("global_compare_at_cents")
  currency       String   @default("INR")
  // ── Per-store sale state ──────────────────────────────────────────
  // Every product answers the same four questions per store — price, show,
  // pre-order, buy now — so the two storefronts can differ. The plain fields
  // are the LOCAL (India) store; the `global*` twins are the International
  // store. Mirrors `priceCents` / `globalPriceCents`.
  //
  // Sale state per store: buy-now wins over pre-order; a product with neither
  // is shown but not purchasable yet ("coming soon").
  isPreOrder     Boolean  @default(false) @map("is_pre_order")
  globalIsPreOrder Boolean @default(false) @map("global_is_pre_order")
  preOrderNotice String?  @map("pre_order_notice")
  images         String[]
  // Shipping weight in grams, used for Delhivery rate calc + labels.
  // Nullable until admins fill it in; checkout/fulfillment falls back
  // to DEFAULT_PRODUCT_WEIGHT_GRAMS.
  weightGrams    Int?     @map("weight_grams")
  // Optional product-level stock for products WITHOUT variants. Null means
  // untracked/unlimited (old behavior); variant products keep per-variant
  // stock and this field is ignored.
  stock          Int?
  isActive       Boolean  @default(true) @map("is_active")
  globalIsActive Boolean  @default(true) @map("global_is_active")
  // Feature rollout: enable Buy Now for this product on the local store.
  // Effective value is `product flag || brand flag` (see src/lib/product-flags.ts).
  buyNowEnabled  Boolean  @default(false) @map("buy_now_enabled")
  globalBuyNowEnabled Boolean @default(false) @map("global_buy_now_enabled")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  // INFO tab: optional per-product override of the storewide
  // ProductInfoTemplate blocks. Null = use the global default.
  infoRows       Json?    @map("info_rows")
  // "Product Info" card under Buy Now: an independent two-column list of
  // { heading, body } rows, edited per product. Empty = the card is hidden.
  buyInfoRows    Json?    @map("buy_info_rows")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  brand       Brand            @relation(fields: [brandId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  blocks      ProductBlock[]
  questions   ProductQA[]
  reviews     Review[]
  orderItems  OrderItem[]
  preorders   Preorder[]
  wishlist    WishlistItem[]
  recentViews RecentView[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// A purchasable option of a product, e.g. shade "01 Rose" for a "Choose 1 of 6"
// lip product. Price may override the product base price when it differs. A
// variant may carry its own images (appended to the product gallery and shown
// when the option is picked, like the original's `link_image`) and a swatch
// colour.
model ProductVariant {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  optionLabel String? @map("option_label") // e.g. "Shade"
  optionValue String  @map("option_value") // e.g. "01 Rose"
  sku         String  @unique
  priceCents  Int?    @map("price_cents")
  // International-store variant price in INR paise (mirrors Product.globalPriceCents),
  // charged on the global store when the variant has its own local price too.
  globalPriceCents Int? @map("global_price_cents")
  // Option images: the first one leads the gallery when the option is picked.
  images    String[] @default([])
  // Swatch colour (hex, e.g. "#faddc3") used to render the option chip.
  color     String?
  // Admin-defined display order of the options.
  sortOrder Int      @default(0) @map("sort_order")
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// An ordered content block that makes up a product's DETAIL tab. `type` maps to
// a renderer + config schema in the product-blocks registry
// (src/lib/product-blocks), and `config` holds type-specific settings (text,
// image size, alignment, styling…). Mirrors the page-builder's PageSection so
// admins can compose the detail page freely.
model ProductBlock {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  type      String // registry key, e.g. "rich-text"
  title     String? // admin label
  config    Json // type-specific settings
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_blocks")
}

// Storewide INFO ("MORE INFORMATION": payment / shipping / returns / inquiry)
// content, shown on every product page unless a product overrides it with its
// own `Product.infoRows`. `blocks` is an ordered list of { heading, body }.
model ProductInfoTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @default("default")
  blocks    Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_info_templates")
}

// A curated Q&A entry on a product page. Admins author these directly and can
// promote a good user submission (source = USER) into the visible list;
// `sortOrder` drives manual ordering. Only status = PUBLISHED is shown.
model ProductQA {
  id            String   @id @default(cuid())
  productId     String   @map("product_id")
  question      String
  answer        String?
  sortOrder     Int      @default(0) @map("sort_order")
  isVisible     Boolean  @default(true) @map("is_visible")
  source        String   @default("ADMIN") // ADMIN | USER
  status        String   @default("PUBLISHED") // PUBLISHED | PENDING | DISCARDED
  submittedById String?  @map("submitted_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_qa")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PRE_ORDER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

/// Staff review of a global order's uploaded ID: global orders arrive as
/// PENDING and are approved or rejected by hand. Local orders stay NONE.
enum OrderApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String?     @map("user_id")
  email         String
  status        OrderStatus @default(PENDING)
  currency      String      @default("INR")
  // Which storefront version placed the order (local = India/INR,
  // global = international/USD). Set from the request version at checkout and
  // used for admin filtering and per-account payment routing.
  siteVersion   String      @default("local") @map("site_version")
  subtotalCents Int         @map("subtotal_cents")
  shippingCents Int         @default(0) @map("shipping_cents")
  discountCents Int         @default(0) @map("discount_cents")
  totalCents    Int         @map("total_cents")
  isPreOrder    Boolean     @default(false) @map("is_pre_order")
  // Photo ID the customer uploads at checkout on the global site (direct
  // shipping). Stored as the public blob URL of the uploaded image.
  idDocumentUrl  String?            @map("id_document_url")
  approvalStatus OrderApprovalStatus @default(NONE) @map("approval_status")
  // Free-text reason kept with the decision (shown to staff, not the customer).
  approvalNote   String?            @map("approval_note")
  approvedAt     DateTime?          @map("approved_at")
  // Set exactly once when the paid side effects (stock decrement, customer
  // confirmation, admin alert) run — the atomic claim that makes retried
  // captures/order.paid/cron reconciliation idempotent per order.
  paidSideEffectsAt DateTime? @map("paid_side_effects_at")
  billing       Json?
  shipping      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user        User?              @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  shipments   Shipment[]
  couponRedemptions CouponRedemption[]
  mileage     MileageLedger[]
  invoice     Invoice?

  @@index([userId])
  @@index([status])
  @@index([siteVersion])
  @@index([approvalStatus])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  variantId   String? @map("variant_id")
  name        String
  optionValue String? @map("option_value")
  sku         String?
  priceCents  Int     @map("price_cents")
  quantity    Int     @default(1)
  currency    String  @default("INR")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// A pre-order placed from the product page. Kept separate from Order because a
// pre-order is just a reservation (name/email/quantity) with no payment yet;
// it can be marked fulfilled once stock arrives.
model Preorder {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String
  email     String
  phone     String?
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city      String?
  state     String?
  postal    String?
  country   String?  @default("IN")
  quantity  Int      @default(1)
  // Which storefront the pre-order came from (pre-orders can be enabled per
  // store now). "local" | "global".
  siteVersion String @default("local") @map("site_version")
  status    String   @default("PENDING") // "PENDING" | "FULFILLED"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("preorders")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  provider    String // "razorpay" | "stripe"
  providerRef String?       @map("provider_ref")
  amountCents Int           @map("amount_cents")
  currency    String        @default("INR")
  // Store version / Razorpay account this payment belongs to. Derived from the
  // order at creation so reconciliation and refunds use the right account.
  siteVersion String        @default("local") @map("site_version")
  status      PaymentStatus @default(CREATED)
  // Did the captured path actually decrement stock? Refunds restock only
  // when true (the oversell guard can capture payment without decrement).
  stockTaken  Boolean       @default(false) @map("stock_taken")
  rawPayload  Json?         @map("raw_payload")
  createdAt   DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerRef])
  @@map("payments")
}

// Audit trail for destructive admin actions on orders. Rows are standalone
// (no relation) so they survive the order deletion they record.
model OrderAuditLog {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  orderNumber String   @map("order_number")
  action      String // e.g. "DELETE"
  actorEmail  String?  @map("actor_email")
  snapshot    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orderNumber])
  @@map("order_audit_logs")
}

// Every photo-ID review decision taken on an order, oldest first. Staff can
// change a decision at any time, so the order keeps only the current state
// while this table keeps the trail. Standalone (like OrderAuditLog) so the
// history survives an order deletion.
model OrderApprovalLog {
  id          String              @id @default(cuid())
  orderId     String              @map("order_id")
  orderNumber String              @map("order_number")
  decision    OrderApprovalStatus
  note        String?
  actorEmail  String?             @map("actor_email")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_approval_logs")
}

// ---------------------------------------------------------------------------
// Fulfillment (Delhivery)
// ---------------------------------------------------------------------------
// One Order can have multiple Shipment rows over its life (cancel + recreate,
// dashboard-created imports). `waybill` is Delhivery's tracking number and the
// join key for webhook events; `clientOrderRef` mirrors our own orderNumber so
// Delhivery-side data always resolves back to us. Statuses mirror Delhivery's
// lifecycle; Order.status is derived forward-only from these.

enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  IN_TRANSIT
  DELIVERED
  RTO
  CANCELLED
  FAILED // e.g. amount mismatch, or unknown tracking state
}

// Who last wrote the row: our app, the admin (manual import/edit), or a
// Delhivery webhook/sync. Purely provenance metadata for the admin UI.
enum ShipmentSource {
  APP
  ADMIN
  DELHIVERY
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @map("order_id")
  provider       String         @default("delhivery")
  waybill        String         @unique
  clientOrderRef String         @map("client_order_ref") // = Order.orderNumber
  status         ShipmentStatus @default(CREATED)
  // Delhivery's own status string from the last event/sync (for debugging).
  providerStatus String?        @map("provider_status")
  labelUrl       String?        @map("label_url")
  codAmountCents Int            @default(0) @map("cod_amount_cents")
  // Always-prepaid for Razorpay orders; kept as a column for future COD.
  isCod          Boolean        @default(false) @map("is_cod")
  lastEventAt    DateTime?      @map("last_event_at")
  lastSyncedAt   DateTime?      @map("last_synced_at")
  source         ShipmentSource @default(APP)
  rawPayload     Json?          @map("raw_payload")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

// ---------------------------------------------------------------------------
// Loyalty & promotions
// ---------------------------------------------------------------------------

enum CouponType {
  PERCENT
  FIXED
  SHIPPING
}

/// What a coupon applies to. ALL covers the whole cart; the others narrow it to
/// a brand, a category, or a set of products.
enum CouponScope {
  ALL
  BRAND
  CATEGORY
  PRODUCT
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int // percent (0-100) or amount in minor units
  minOrderCents Int?       @map("min_order_cents")
  maxUses       Int?
  perUserLimit  Int?       @map("per_user_limit")
  startsAt      DateTime?  @map("starts_at")
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  // ── Display + eligibility ────────────────────────────────────────────────
  title       String? // shown on the coupon cards/chips
  description String?
  scope       CouponScope @default(ALL)
  brandId     String?     @map("brand_id")
  categoryId  String?     @map("category_id")
  productIds  String[]    @default([]) @map("product_ids")
  // Which storefront the coupon belongs to: "all" | "local" | "global".
  siteVersion       String  @default("all") @map("site_version")
  // First-purchase coupons only apply when the shopper has no completed order.
  firstPurchaseOnly Boolean @default(false) @map("first_purchase_only")
  // Whether the coupon may be used on pre-order items. Off by default: a
  // pre-order is a promise to ship later, and most offers are meant for stock
  // that ships now. Also controls whether the code is advertised on a
  // pre-order product's page.
  preOrderAllowed Boolean @default(false) @map("pre_order_allowed")

  redemptions CouponRedemption[]

  @@index([siteVersion])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String   @map("coupon_id")
  // Null for guest checkouts: the order email identifies the shopper instead,
  // so per-customer limits still count a guest's earlier uses.
  userId     String?  @map("user_id")
  email      String?  @map("email")
  orderId    String   @map("order_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([email])
  @@map("coupon_redemptions")
}

// Append-only ledger so a user's running balance can always be reconstructed
// and audited.
model MileageLedger {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  delta        Int // positive = earned, negative = spent
  reason       String
  orderId      String?  @map("order_id")
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("mileage_ledger")
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  rating     Int
  title      String?
  body       String?
  images     String[]
  isVerified Boolean  @default(false) @map("is_verified")
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  // Visibility on the storefront. Reviews are shown by default once they pass
  // validation; admins can hide any review.
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RecentView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@map("recent_views")
}

// ---------------------------------------------------------------------------
// Content: banners & popups (managed from the admin dashboard)
// ---------------------------------------------------------------------------

// A promotional image banner rendered in a storefront section. `placement`
// selects which section it belongs to (long banner, hero carousel, triple
// banner) — the long-banner placement is currently rendered on the homepage.
model Banner {
  id          String    @id @default(cuid())
  title       String // admin label, e.g. "Summer Sale"
  placement   String    @default("long") // "long" | "hero" | "triple"
  image       String // desktop image URL
  mobileImage String?   @map("mobile_image") // taller mobile variant; falls back to image
  alt         String?
  href        String? // optional link target
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, placement, sortOrder])
  @@map("banners")
}

// A promotional overlay shown to visitors (e.g. a sale announcement or
// newsletter signup). `frequency` controls whether it appears once per browser
// session ("once") or on every page load ("every").
model Popup {
  id        String    @id @default(cuid())
  // ── Content ─────────────────────────────────────────────────────────
  // "custom" renders title/body/image/button; "store-picker" renders the
  // store-switcher cards instead (the same content as the header's store popup,
  // edited in /admin/site) — used for the once-per-session store prompt.
  contentKind String  @default("custom") @map("content_kind")
  title     String? // headline
  body      String? // supporting text
  image     String? // optional image
  ctaLabel  String?   @map("cta_label") // button label
  ctaHref   String?   @map("cta_href") // button link target
  placement String    @default("center") // "center" | "bottom"
  frequency String    @default("once") // "once" | "day" | "every"

  // ── Layout ─────────────────────────────────────────────────────────
  // Size preset ("sm" | "md" | "lg" | "xl" | "full" | "custom"); a custom
  // size uses widthPx and "full" fills the viewport. `scale` zooms the rendered
  // card in percent without touching the layout width.
  size    String @default("md")
  widthPx Int?   @map("width_px")
  scale   Int    @default(100) // 50–150
  // How the image and the text share the card: "auto" (image above text),
  // "image" (an image-only popup that fills the card) or "text".
  contentLayout String @default("auto") @map("content_layout")
  // Fixed media height in px; null = the image keeps its own aspect ratio.
  // A set height crops the image to fill it.
  imageHeightPx Int? @map("image_height_px")
  // Text alignment inside the card: "left" | "center".
  textAlign String @default("left") @map("text_align")

  // ── Timing ─────────────────────────────────────────────────────────
  // delaySeconds waits before the popup appears; timeoutSeconds closes it
  // automatically (0 = it waits for the visitor).
  delaySeconds   Int @default(0) @map("delay_seconds")
  timeoutSeconds Int @default(0) @map("timeout_seconds")

  // ── Overlay & dismissal ────────────────────────────────────────────
  overlay        Boolean @default(true)
  overlayOpacity Int     @default(50) @map("overlay_opacity") // 0–90 (%)
  closeOnOverlay Boolean @default(true) @map("close_on_overlay")
  // Show the "Don't show again today" link in the popup's footer.
  hideToday Boolean @default(true) @map("hide_today")

  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([isActive, placement])
  @@map("popups")
}

// ---------------------------------------------------------------------------
// Invoices
// ---------------------------------------------------------------------------
// One invoice per order, issued automatically once the order is confirmed.
// The line items and the "from" block are rendered live from the order and the
// store's site config, so a change to the order (status, address, refunds) is
// reflected the next time the invoice is opened; `fromSnapshot` keeps the
// legal entity that was current when the invoice was issued.

model Invoice {
  id       String @id @default(cuid())
  orderId  String @unique @map("order_id")
  number   String @unique
  issuedAt DateTime @default(now()) @map("issued_at")
  fromSnapshot Json? @map("from_snapshot")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([issuedAt])
  @@map("invoices")
}

// ---------------------------------------------------------------------------
// Ambassador programme
// ---------------------------------------------------------------------------

/// One application submitted from the storefront ambassador page, reviewed by
/// staff in the admin dashboard.
enum AmbassadorStatus {
  PENDING
  APPROVED
  REJECTED
}

model AmbassadorApplication {
  id          String            @id @default(cuid())
  siteVersion String            @default("local") @map("site_version")
  status      AmbassadorStatus  @default(PENDING)
  // Applicant details. Socials and audience are free text: the form asks for
  // them, nothing validates them.
  name        String
  email       String
  phone       String?
  country     String?
  city        String?
  instagram   String?
  tiktok      String?
  youtube     String?
  blog        String?
  followers   String?
  audience    String?
  motivation  String?
  experience  String?
  // Staff notes kept with the decision.
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([siteVersion])
  @@index([status])
  @@map("ambassador_applications")
}

// ---------------------------------------------------------------------------
// Page builder: dynamically structured pages
// ---------------------------------------------------------------------------
// A Page is an ordered list of typed Sections. Each section's `type` maps to a
// renderer + config schema in the section-type registry (src/lib/page-builder),
// and its `config` JSON holds type-specific settings. `sortOrder` drives the
// display order; `isActive` + optional schedule control visibility. This lets
// admins add, reorder, remove, and customize sections without code changes.

// ---------------------------------------------------------------------------
// Site configuration: per-version storefront content
// ---------------------------------------------------------------------------
// One row per site version (local = our-nara.com/India, global =
// our-nara.co.kr/KDrop). Holds the contact details shown across the storefront
// (footer, policies), the rotating strips at the very top of the page, and the
// store-picker popup content. Edited from /admin/site; every storefront surface
// reads it through `src/lib/site-config.ts` so there is one place to change.

model SiteConfig {
  id      String @id @default(cuid())
  version String @unique // "local" | "global"

  // ── Contact details (footer, policies, order emails) ───────────────
  email   String?
  phone   String?
  address String?

  // ── Stores page (/stores) ──────────────────────────────────────────
  // Stores are their own table (`stores`) so the admin can keep a list per
  // storefront; the old per-version store_* columns were dropped with the
  // stores_list migration.

  // ── Shipping ───────────────────────────────────────────────────────
  // What this store charges for delivery, and the order value above which
  // delivery is free (null = never free). The storefront shows a progress
  // bar towards the milestone while it is set.
  shippingCents         Int  @default(0) @map("shipping_cents")
  freeShippingOverCents Int? @map("free_shipping_over_cents")
  // Hour (0–23) after which an order joins tomorrow's dispatch; 3 PM when unset.
  dispatchCutoffHour Int? @map("dispatch_cutoff_hour")

  // ── Invoice "from" block ───────────────────────────────────────────
  // Printed on this store's invoices; the legal entity differs per store, so
  // each version keeps its own.
  invoiceLegalName String? @map("invoice_legal_name")
  invoiceAddress   String? @map("invoice_address")
  invoiceEmail     String? @map("invoice_email")
  invoicePhone     String? @map("invoice_phone")
  invoiceTaxId     String? @map("invoice_tax_id")
  invoiceNote      String? @map("invoice_note")

  // ── Storefront content ─────────────────────────────────────────────────
  // Rotating strips pinned above the header: an ordered list of blocks, each a
  // line of text or an image, with its own colours link.
  topBanner Json?
  // The store-picker popup: heading, note and one block per store.
  switcher  Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_configs")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "home"
  title     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections PageSection[]

  @@map("pages")
}

model PageSection {
  id        String    @id @default(cuid())
  pageId    String    @map("page_id")
  type      String // registry key, e.g. "product-grid"
  title     String? // admin label
  config    Json // type-specific settings
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

// ---------------------------------------------------------------------------
// Feedback (contact-us submissions)
// ---------------------------------------------------------------------------
// Messages sent through the storefront contact dialog. Status tracks the
// admin triage workflow: NEW (unhandled) -> IN_PROGRESS -> RESOLVED, with
// ARCHIVED for noise/spam.

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model Feedback {
  id        String         @id @default(cuid())
  email     String
  message   String
  status    FeedbackStatus @default(NEW)
  // Error/trace context captured at submit time (page URL, browser, error).
  errorName    String? @map("error_name")
  errorMessage String? @map("error_message")
  errorDigest  String? @map("error_digest")
  errorUrl     String? @map("error_url")
  userAgent    String? @map("user_agent")
  ip           String?
  adminNote    String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Stores: the physical shops shown on /stores
// ---------------------------------------------------------------------------
// A dynamic list per storefront version. The admin adds, edits, reorders and
// removes rows in /admin/stores; the /stores page renders them in `sortOrder`.
// `hours` holds one entry per weekday (see src/lib/store-hours.ts) and
// `mapQuery` is a place name/address or "lat,lng" for the embedded map.

model Store {
  id        String   @id @default(cuid())
  version   String // "local" | "global"
  name      String   @default("")
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  hours     Json?
  mapQuery  String   @default("") @map("map_query")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([version, sortOrder])
  @@map("stores")
}
