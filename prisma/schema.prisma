// OUR:NARA — Prisma schema
// PostgreSQL · Prisma 7 (`prisma-client` TS generator)
//
// Money is stored as integer minor units (paise for INR) to avoid floating
// point errors. Every money field carries a `currency` so the store can add
// multi-currency pricing later without a migration of intent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth)
// ---------------------------------------------------------------------------
// The User model is the Better Auth user. Passwords are stored in the Account
// model (providerId = "credential"), not on the user. `role` is one of
// normal | manager | admin; `permissions` holds per-user permission overrides
// merged on top of the role defaults (see src/lib/permissions.ts).

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  username        String?   @unique // member ID (lowercase a-z0-9, 4-16)
  displayUsername String?   @map("display_username")
  role            String    @default("normal")
  banned          Boolean?  @default(false)
  banReason       String?   @map("ban_reason")
  banExpires      DateTime? @map("ban_expires")

  // Custom signup fields
  firstName     String? @map("first_name")
  lastName      String? @map("last_name")
  country       String?
  addressLine1  String? @map("address_line1")
  addressLine2  String? @map("address_line2")
  city          String?
  state         String?
  postal        String?
  telephoneCode String? @map("telephone_code")
  telephone     String?
  mobileCode    String? @map("mobile_code")
  mobile        String?
  permissions   Json? // per-user permission overrides, e.g. { product: ["create"] }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  wishlist          WishlistItem[]
  recentViews       RecentView[]
  mileage           MileageLedger[]
  couponRedemptions CouponRedemption[]
  sessions          Session[]
  accounts          Account[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Address {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  label     String
  recipient String
  line1     String
  line2     String?
  city      String
  state     String?
  postal    String
  country   String  @default("IN")
  phone     String?
  isDefault Boolean @default(false) @map("is_default")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?  @map("logo_url")
  coverUrl    String?  @map("cover_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  brandId        String   @map("brand_id")
  categoryId     String   @map("category_id")
  name           String
  summary        String?
  shortTags      String[] @map("short_tags")
  description    String?
  priceCents     Int      @map("price_cents")
  compareAtCents Int?     @map("compare_at_cents")
  currency       String   @default("INR")
  isPreOrder     Boolean  @default(false) @map("is_pre_order")
  preOrderNotice String?  @map("pre_order_notice")
  images         String[]
  isActive       Boolean  @default(true) @map("is_active")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  brand       Brand            @relation(fields: [brandId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  recentViews RecentView[]

  @@index([brandId])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// A purchasable option of a product, e.g. shade "01 Rose" for a "Choose 1 of 6"
// lip product. Price may override the product base price when it differs.
model ProductVariant {
  id          String  @id @default(cuid())
  productId   String  @map("product_id")
  optionLabel String? @map("option_label") // e.g. "Shade"
  optionValue String  @map("option_value") // e.g. "01 Rose"
  sku         String  @unique
  priceCents  Int?    @map("price_cents")
  stock       Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  PRE_ORDER
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String?     @map("user_id")
  email         String
  status        OrderStatus @default(PENDING)
  currency      String      @default("INR")
  subtotalCents Int         @map("subtotal_cents")
  shippingCents Int         @default(0) @map("shipping_cents")
  discountCents Int         @default(0) @map("discount_cents")
  totalCents    Int         @map("total_cents")
  isPreOrder    Boolean     @default(false) @map("is_pre_order")
  billing       Json?
  shipping      Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user        User?              @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]
  redemptions CouponRedemption[]
  mileage     MileageLedger[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  variantId   String? @map("variant_id")
  name        String
  optionValue String? @map("option_value")
  sku         String?
  priceCents  Int     @map("price_cents")
  quantity    Int     @default(1)
  currency    String  @default("INR")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  provider    String // "razorpay" | "stripe"
  providerRef String?       @map("provider_ref")
  amountCents Int           @map("amount_cents")
  currency    String        @default("INR")
  status      PaymentStatus @default(CREATED)
  rawPayload  Json?         @map("raw_payload")
  createdAt   DateTime      @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([providerRef])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Loyalty & promotions
// ---------------------------------------------------------------------------

enum CouponType {
  PERCENT
  FIXED
  SHIPPING
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int // percent (0-100) or amount in minor units
  minOrderCents Int?       @map("min_order_cents")
  maxUses       Int?
  perUserLimit  Int?       @map("per_user_limit")
  startsAt      DateTime?  @map("starts_at")
  expiresAt     DateTime?  @map("expires_at")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String   @map("coupon_id")
  userId     String   @map("user_id")
  orderId    String   @map("order_id")
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// Append-only ledger so a user's running balance can always be reconstructed
// and audited.
model MileageLedger {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  delta        Int // positive = earned, negative = spent
  reason       String
  orderId      String?  @map("order_id")
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("mileage_ledger")
}

// ---------------------------------------------------------------------------
// Social
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  rating     Int
  title      String?
  body       String?
  images     String[]
  isVerified Boolean  @default(false) @map("is_verified")
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RecentView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@map("recent_views")
}

// ---------------------------------------------------------------------------
// Content: banners & popups (managed from the admin dashboard)
// ---------------------------------------------------------------------------

// A promotional image banner rendered in a storefront section. `placement`
// selects which section it belongs to (long banner, hero carousel, triple
// banner) — the long-banner placement is currently rendered on the homepage.
model Banner {
  id          String    @id @default(cuid())
  title       String // admin label, e.g. "Summer Sale"
  placement   String    @default("long") // "long" | "hero" | "triple"
  image       String // desktop image URL
  mobileImage String?   @map("mobile_image") // taller mobile variant; falls back to image
  alt         String?
  href        String? // optional link target
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, placement, sortOrder])
  @@map("banners")
}

// A promotional overlay shown to visitors (e.g. a sale announcement or
// newsletter signup). `frequency` controls whether it appears once per browser
// session ("once") or on every page load ("every").
model Popup {
  id        String    @id @default(cuid())
  title     String? // headline
  body      String? // supporting text
  image     String? // optional image
  ctaLabel  String?   @map("cta_label") // button label
  ctaHref   String?   @map("cta_href") // button link target
  placement String    @default("center") // "center" | "bottom"
  frequency String    @default("once") // "once" | "every"
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([isActive, placement])
  @@map("popups")
}

// ---------------------------------------------------------------------------
// Page builder: dynamically structured pages
// ---------------------------------------------------------------------------
// A Page is an ordered list of typed Sections. Each section's `type` maps to a
// renderer + config schema in the section-type registry (src/lib/page-builder),
// and its `config` JSON holds type-specific settings. `sortOrder` drives the
// display order; `isActive` + optional schedule control visibility. This lets
// admins add, reorder, remove, and customize sections without code changes.

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "home"
  title     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections PageSection[]

  @@map("pages")
}

model PageSection {
  id        String    @id @default(cuid())
  pageId    String    @map("page_id")
  type      String // registry key, e.g. "product-grid"
  title     String? // admin label
  config    Json // type-specific settings
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_sections")
}
