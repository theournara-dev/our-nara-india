# --- Auth (Better Auth) ---
# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# Base URL of the app (http://localhost:3000 in dev)
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
# Verified sender. Use onboarding@resend.dev until your domain is verified.
EMAIL_FROM="OUR:NARA <no-reply@our-nara.com>"
# Dev-only inbox that always accepts mail (resend.dev): delivered@resend.dev
RESEND_TEST_TO=""

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Fulfillment (Delhivery) ---
# API token from the One Delhivery panel (Client Settings → API token).
DELHIVERY_API_TOKEN=""
# API surface. Leave unset for the default (https://track.delhivery.com);
# switch to the One B2C URL when your account manager confirms it.
DELHIVERY_BASE_URL=""
# Warehouse/pickup location name exactly as registered in the Delhivery panel.
DELHIVERY_PICKUP_LOCATION=""

# --- Cron (Vercel Cron for /api/cron/daily-sync) ---
# Any long random string; Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
