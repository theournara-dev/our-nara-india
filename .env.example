# ─── Database (Prisma / Neon Postgres) ──────────────────────────────────────
# Connection string. For Vercel Postgres / Neon use the pooled or direct URL:
# postgresql://USER:PASSWORD@HOST/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ournara?schema=public"

# ─── Payments: Razorpay ──────────────────────────────────────────────────────
# Use your test keys for development: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Optional webhook secret set in the Razorpay dashboard (used to verify signatures)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ─── Site ────────────────────────────────────────────────────────────────────
# Used for canonical URLs and Open Graph. Vercel sets NEXT_PUBLIC_VERCEL_URL in preview.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
